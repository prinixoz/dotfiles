#!/usr/bin/env bash

# 1. Initialize variables
PAUSE_MEDIA=0
ENABLE_SLEEP=0
SLEEP_DELAY=1800 # Default to 300 seconds (5 mins)
SWAYLOCK_ARGS=()

# 2. Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        -v|--video-pause)
            PAUSE_MEDIA=1
            shift # Move past the argument
            ;;
        -s|--sleep)
            ENABLE_SLEEP=1
            # Check if the next argument ($2) is a number
            if [[ -n "$2" ]] && [[ "$2" =~ ^[0-9]+$ ]]; then
                SLEEP_DELAY="$2"
                shift 2 # Move past the flag and the number
            else
                shift 1 # Move past the flag, use default SLEEP_DELAY
            fi
            ;;
        -h|--help)
            echo "Usage: $0 [-v|--video-pause] [-s|--sleep [seconds]] [swaylock arguments...]"
            exit 0
            ;;
        *)
            # If it's not a script flag, save it to pass to swaylock later
            SWAYLOCK_ARGS+=("$1")
            shift
            ;;
    esac
done

# 3. Check if already locked
if pgrep -x swaylock >/dev/null 2>&1; then
    echo "swaylock already running, skipping new lock"
    exit 0
fi

# 4. Execute media pause if the flag was passed
if [ "$PAUSE_MEDIA" -eq 1 ]; then
    playerctl -a pause >/dev/null 2>&1 &
    mpc pause >/dev/null 2>&1 &
fi


# 6. Start sleep timer in the background if enabled
if [ "$ENABLE_SLEEP" -eq 1 ]; then
    (
        sleep "$SLEEP_DELAY"
        systemctl suspend
    ) &
    # Save the Process ID (PID) of the background timer
    SLEEP_TIMER_PID=$! 
fi

# 5. Turn off lights
wizctl off&

# 7. Run swaylock with any remaining arguments (blocking)
swaylock "${SWAYLOCK_ARGS[@]}"

# 8. Cancel the sleep timer immediately after unlock (if it hasn't fired yet)
if [ "$ENABLE_SLEEP" -eq 1 ] && kill -0 "$SLEEP_TIMER_PID" 2>/dev/null; then
    kill "$SLEEP_TIMER_PID" >/dev/null 2>&1
fi

# 9. Post-unlock network check and lights on
(GATEWAY_IP="192.168.29.1"
    COUNTER=0

    while ! ping -c 1 -W 1 "$GATEWAY_IP" >/dev/null 2>&1; do
        COUNTER=$((COUNTER + 1))
        if [ "$COUNTER" -ge 100 ]; then
            echo "Network timeout reached."
            break
        fi
        sleep 0.1
    done

    wizctl on &
) &
