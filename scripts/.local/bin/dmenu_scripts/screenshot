#!/bin/bash

# Prevent overlapping slurp processes
killall -q slurp

# 1. Select the screenshot target (Screen or Select)
option=$1
[ -z "$option" ] && option=$(printf "Select\nScreen" | dmenu -p "Capture:" | tr '[:upper:]' '[:lower:]')
[ -z "$option" ] && exit 1

tmp_img=$(mktemp /tmp/screenshot.XXXXXX.png)

case "$option" in
    screen) 
        grim "$tmp_img"
        ;;
    select|*) 
        # Extra kill check to ensure no rogue instance remains
        killall -q slurp
        geometry=$(slurp) || { rm -f "$tmp_img"; exit 1; }
        grim -g "$geometry" "$tmp_img"
        ;;
esac

# 2. Select the action (Copy or Save)
type=$(printf "Copy\nSave" | dmenu -p "Action:" | tr '[:upper:]' '[:lower:]')

case "$type" in
    save) 
        dir="/mnt/PS/Picture/Sreenshot"
        [ -d "$dir" ] || mkdir -p "$dir"
        
        filename="Sreenshot $(date +'%d-%m-%Y %T').png"
        filepath="$dir/$filename"
        
        mv "$tmp_img" "$filepath"
        notify-send "Screenshot Saved" "Location: $filepath"
        ;;
    copy|*) 
        wl-copy < "$tmp_img"
        rm -f "$tmp_img"
        notify-send "Screenshot" "Copied to clipboard"
        ;;
esac
