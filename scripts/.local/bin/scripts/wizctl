#!/bin/bash

# Source network configuration
if [ -f ~/.config/mac ]; then
    source ~/.config/mac
fi

PORT=38899

show_help() {
    cat << 'EOF'
A simple command line utility for controlling Wiz Connected LED light strips.

Usage: wizctl [OPTIONS] <COMMAND> [SUB-OPTIONS]
       wizctl id <NUMBER> [COMMAND] [SUB-OPTIONS]

Commands:
  id         Select a light target by index number (e.g., id 2 off) or list all IDs
  dynamic    Sets the dynamic scene the light strip(s) use(s)
  static     Sets the static color the light strip(s) use(s)
  brightness Sets the brightness level (10-100)
  on         Turns on the light strip(s)
  off        Turns off the light strip(s)
  help       Print this message

Options:
  -i, --ip <IP>          The IP Address of the light strip
  --id <NUMBER>          Select a light target by configuration index number
  -b, --brightness <VAL> Set brightness level (10-100)
  -s, --scene <NAME>     Set dynamic scene name
  -p, --speed <VAL>      Set dynamic scene speed
  -h, --help             Print help
EOF
}

# --- Toggle Logic for No Arguments ---
if [ $# -eq 0 ]; then
    TARGET_IP="${WIZ_IP}"
    if [ -z "$TARGET_IP" ]; then
        echo "Error: Default \$WIZ_IP not found in ~/.config/mac"
        exit 1
    fi
    
    response=$(echo '{"method":"getPilot","params":{}}' | nc -u -w 1 "$TARGET_IP" "$PORT" 2>/dev/null)
    
    if echo "$response" | grep -q '"state":true'; then
        payload='{"id":1,"method":"setState","params":{"state":false}}'
    else
        payload='{"id":1,"method":"setState","params":{"state":true}}'
    fi
    
    echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
    exit 0
fi

# --- Variables ---
TARGET_IP=""
ID_INDEX=""
COMMAND=""
OPT_BRIGHTNESS=""
OPT_SCENE=""
OPT_SPEED=""
ID_COMMAND_ONLY=false
POS_ARGS=()

# --- Advanced Argument Parsing ---
while [[ $# -gt 0 ]]; do
    case "$1" in
        -i|--ip)
            TARGET_IP="$2"
            shift 2
            ;;
        --id)
            ID_INDEX="$2"
            shift 2
            ;;
        id)
            if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
                ID_INDEX="$2"
                shift 2
            else
                ID_COMMAND_ONLY=true
                shift
            fi
            ;;
        -b|--brightness)
            OPT_BRIGHTNESS="$2"
            shift 2
            ;;
        -s|--scene)
            OPT_SCENE="$2"
            shift 2
            ;;
        -p|--speed)
            OPT_SPEED="$2"
            shift 2
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        on|off|dynamic|static|brightness)
            COMMAND="$1"
            shift
            ;;
        -*)
            echo "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            POS_ARGS+=("$1")
            shift
            ;;
    esac
done

# Handle 'wizctl id' status listing rule
if [ "$ID_COMMAND_ONLY" = true ] && [ -z "$COMMAND" ]; then
    echo "Configured WiZ Light IDs:"
    if [ -n "$WIZ_IP" ]; then
        echo "1 : $WIZ_IP"
    fi
    for var in $(set | awk -F= '/^WIZ_IP[0-9]+/ {print $1}' | sort -V); do
        if [ -n "$var" ]; then
            num=$(echo "$var" | tr -d -c '0-9')
            echo "$num : ${!var}"
        fi
    done
    exit 0
fi

# Resolve IP matching based on ID Index input
if [ -n "$ID_INDEX" ]; then
    if [ "$ID_INDEX" -eq 1 ]; then
        TARGET_IP="$WIZ_IP"
    else
        var_name="WIZ_IP${ID_INDEX}"
        TARGET_IP="${!var_name}"
    fi
    
    if [ -z "$TARGET_IP" ]; then
        echo "Error: Target ID '$ID_INDEX' is empty or not defined in ~/.config/mac"
        exit 1
    fi
fi

TARGET_IP="${TARGET_IP:-$WIZ_IP}"

if [ -z "$TARGET_IP" ]; then
    echo "Error: IP address not specified. Use -i <IP>, id <NUM>, or set \$WIZ_IP in ~/.config/mac"
    exit 1
fi

# --- Intelligent Command Inference ---
if [ -z "$COMMAND" ]; then
    if [ -n "$OPT_SCENE" ]; then
        COMMAND="dynamic"
    elif [ -n "$OPT_BRIGHTNESS" ]; then
        COMMAND="brightness"
        POS_ARGS=("$OPT_BRIGHTNESS")
    else
        show_help
        exit 0
    fi
fi

# --- Scene Name Mapping Function ---
get_scene_id() {
    case "${1,,}" in
        "ocean")          echo 1 ;;
        "romance")        echo 2 ;;
        "sunset")         echo 3 ;;
        "party")          echo 4 ;;
        "fireplace")      echo 5 ;;
        "cozy")           echo 6 ;;
        "forest")         echo 7 ;;
        "pastel-colors")  echo 8 ;;
        "wake-up")        echo 9 ;;
        "bedtime")        echo 10 ;;
        "warm-white")     echo 11 ;;
        "daylight")       echo 12 ;;
        "cool-white")     echo 13 ;;
        "night-light")    echo 14 ;;
        "focus")          echo 15 ;;
        "relax")          echo 16 ;;
        "true-colors")    echo 17 ;;
        "tv-time")        echo 18 ;;
        "plantgrowth")    echo 19 ;;
        "spring")         echo 20 ;;
        "summer")         echo 21 ;;
        "fall")           echo 22 ;;
        "deepdive")       echo 23 ;;
        "jungle")         echo 24 ;;
        "mojito")         echo 25 ;;
        "club")           echo 26 ;;
        "christmas")      echo 27 ;;
        "halloween")      echo 28 ;;
        "candlelight")    echo 29 ;;
        "golden-white")   echo 30 ;;
        "pulse")          echo 31 ;;
        "steampunk")      echo 32 ;;
        "rhythm")         echo 1000 ;;
        *)                echo "" ;;
    esac
}

# --- Process Commands ---
case "$COMMAND" in
    on)
        if [ -n "$OPT_BRIGHTNESS" ]; then
            payload=$(printf '{"id":1,"method":"setPilot","params":{"state":true,"dimming":%d}}' "$OPT_BRIGHTNESS")
        else
            payload='{"id":1,"method":"setState","params":{"state":true}}'
        fi
        echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
        ;;
        
    off)
        payload='{"id":1,"method":"setState","params":{"state":false}}'
        echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
        ;;
        
    brightness)
        BRIGHTNESS="${OPT_BRIGHTNESS:-${POS_ARGS[0]}}"
        if [ -z "$BRIGHTNESS" ] || ! [[ "$BRIGHTNESS" =~ ^[0-9]+$ ]]; then
            echo "Error: Missing or invalid brightness value (use 10-100)."
            exit 1
        fi
        payload=$(printf '{"id":1,"method":"setPilot","params":{"dimming":%d}}' "$BRIGHTNESS")
        echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
        ;;
        
    dynamic)
        SCENE_NAME="${OPT_SCENE:-${POS_ARGS[0]}}"
        
        if [ -z "$SCENE_NAME" ] || [ "$SCENE_NAME" = "--help" ] || [ "$SCENE_NAME" = "-h" ]; then
            echo "Available scenes: ocean romance sunset party fireplace cozy forest pastel-colors wake-up bedtime warm-white daylight cool-white night-light focus relax true-colors tv-time plantgrowth spring summer fall deepdive jungle mojito club christmas halloween candlelight golden-white pulse steampunk rhythm" | tr ' ' '\n'
            exit 0
        fi

        scene_id=$(get_scene_id "$SCENE_NAME")
        if [ -z "$scene_id" ]; then
            echo "Error: Unknown dynamic scene '$SCENE_NAME'."
            exit 1
        fi

        SPEED="${OPT_SPEED:-${POS_ARGS[1]:-20}}"
        # If brightness wasn't explicitly passed with --brightness, use position 2 or default to 75
        BRIGHTNESS="${OPT_BRIGHTNESS:-${POS_ARGS[2]:-75}}"
        
        payload=$(printf '{"id":1,"method":"setPilot","params":{"sceneId":%d,"speed":%d,"dimming":%d}}' "$scene_id" "$SPEED" "$BRIGHTNESS")
        echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
        ;;
        
    static)
        RED="${POS_ARGS[0]}"
        GREEN="${POS_ARGS[1]}"
        BLUE="${POS_ARGS[2]}"
        BRIGHTNESS="${OPT_BRIGHTNESS:-${POS_ARGS[3]:-75}}"
        
        if [ -z "$RED" ] || [ -z "$GREEN" ] || [ -z "$BLUE" ]; then
            echo "Error: Missing required RGB arguments."
            echo "Usage: wizctl static <RED> <GREEN> <BLUE> [--brightness <VAL>]"
            exit 1
        fi
        
        payload=$(printf '{"id":1,"method":"setPilot","params":{"r":%d,"g":%d,"b":%d,"dimming":%d}}' "$RED" "$GREEN" "$BLUE" "$BRIGHTNESS")
        echo "$payload" | nc -u -w 1 "$TARGET_IP" "$PORT"
        ;;
esac
