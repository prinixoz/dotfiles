include /etc/sway/config.d/*

exec --no-startup-id /usr/lib/xdg-document-portal-wlr &

#==============================================================================
#++++++++++++++++++++++++++++++++++ Colors ++++++++++++++++++++++++++++++++++++
#==============================================================================

client.focused          #ffffff #ffffff #000000 #ffffff #ffffff
client.focused_inactive #888888 #1a1a1a #ffffff #888888 #888888
client.unfocused        #000000 #000000 #888888 #000000 #000000
client.urgent           #ffffff #000000 #ffffff #ffffff #ffffff
client.placeholder      #222222 #000000 #aaaaaa #222222 #222222
client.background       #000000

#==============================================================================
#++++++++++++++++++++++++++++++ Workspace +++++++++++++++++++++++++++++++++++++
#==============================================================================

set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"
set $ws11 "11"

#==============================================================================
#++++++++++++++++++++++++++++ Workspace 1 +++++++++++++++++++++++++++++++++++++
#==============================================================================



#==============================================================================
#+++++++++++++++++++++++++++++++ Variable +++++++++++++++++++++++++++++++++++++
#==============================================================================

set $mod Mod4
set $mod2 Mod4
set $terminal kitty

floating_modifier $mod

#==============================================================================
#++++++++++++++++++++++++++++ Touchpad ++++++++++++++++++++++++++++++++++++++++
#==============================================================================

input type:touchpad {
    dwt enabled
    tap enabled
    middle_emulation enabled
}

seat seat0 hide_cursor 3000

bindgesture swipe:right workspace prev
bindgesture swipe:left workspace next
bindgesture swipe:down scratchpad show

#==============================================================================
#+++++++++++++++++++++++++++++ Switch Workspace +++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod2+1 workspace number $ws1
bindsym $mod2+2 workspace number $ws2
bindsym $mod2+3 workspace number $ws3
bindsym $mod2+4 workspace number $ws4
bindsym $mod2+5 workspace number $ws5
bindsym $mod2+6 workspace number $ws6
bindsym $mod2+7 workspace number $ws7
bindsym $mod2+8 workspace number $ws8
bindsym $mod2+9 workspace number $ws9
bindsym $mod2+0 workspace number $ws10

bindsym $mod2+m scratchpad show

bindsym $mod+Tab workspace next
bindsym $mod+Shift+Tab workspace prev

bindsym $mod+Control+h seat seat0 cursor left
bindsym $mod+Control+j seat seat0 cursor down
bindsym $mod+Control+k seat seat0 cursor up
bindsym $mod+Control+l seat seat0 cursor right

bindsym $mod+s exec obsscene

#==============================================================================
#+++++++++++++++ Move focused container to workspace ++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

bindsym $mod+Shift+m move scratchpad

#==============================================================================
#+++++++++++++++++++++++++ Killing window +++++++++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+q kill
bindsym $mod+Shift+q exec process $men
bindsym $mod+Shift+r reload

#==============================================================================
#++++++++++++++++++++ Window Focus Movement Keys ++++++++++++++++++++++++++++++
#==============================================================================

bindsym Mod1+space exec dunstctl close
bindsym Mod1+shift+space exec dunstctl close-all

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

#==============================================================================
#+++++++++++++++++++++++++++ Terminal Applications ++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+Return exec $terminal
bindsym $mod+c exec $terminal --class floating sh -c htop
bindsym $mod+Shift+c exec $terminal --class floating sh -c nvtop
bindsym $mod+e exec $terminal lf
bindsym $mod+o exec $terminal --class floating sh -c pulsemixer

bindsym $mod+shift+e exec thunar
bindsym $mod+Shift+o exec overview
bindsym $mod+x exec lock -v -s 1800
bindsym $mod+Shift+x exec lock

#==============================================================================
#++++++++++++++++++++++++ Browsers And Electron +++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+a exec bm $men
bindsym $mod+shift+Return exec sdmenu $men
bindsym $mod+Shift+a exec helium-browser --incognito
bindsym $mod+b exec $terminal --class nb sh -c nb
bindsym $mod+Shift+b exec obsidian

#==============================================================================
#+++++++++++++++++++++++ Toggle window focus all ++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+n exec networkmanager_dmenu -l 40 -nb '#0f0f0f'
bindsym $mod+n exec earphone-bluetooth

#==============================================================================
#+++++++++++++++++++++++++++ Move Window Keys +++++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

#==============================================================================
#+++++++++++++++++++++++++++ Volume Keybindings +++++++++++++++++++++++++++++++
#==============================================================================

bindsym XF86AudioRaiseVolume exec --no-startup-id volume up
bindsym XF86AudioLowerVolume exec --no-startup-id volume down
bindsym XF86AudioMute exec --no-startup-id volume mute

bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

#==============================================================================
#+++++++++++++++++++++++++++ Media Keybindings ++++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+shift+space exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioNext exec playerctl next

#==============================================================================
#+++++++++++++++++++++++++++++++ Keyboard +++++++++++++++++++++++++++++++++++++
#==============================================================================


#==============================================================================
#+++++++++++++++++++++++++++ Brightness Keybindings +++++++++++++++++++++++++++
#==============================================================================

bindsym XF86MonBrightnessDown exec brightness down
bindsym XF86MonBrightnessUp exec brightness up

bindsym $mod+Shift+F2 exec brightness down
bindsym $mod+Shift+F3 exec brightness up

#==============================================================================
#++++++++ change container layout (stacked, tabbed, toggle split) +++++++++++++
#==============================================================================

bindsym $mod+comma layout tabbed
bindsym $mod+period layout toggle split

bindsym $mod+Shift+f floating toggle
bindsym $mod+shift+s sticky toggle
bindsym F11 fullscreen toggle

#==============================================================================
#++++++++++++++++++ Vertical and Horizontal Split +++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+semicolon split h
bindsym $mod+apostrophe split v

#==============================================================================
#+++++++++++++++++++++++++++++++ Extras +++++++++++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+Shift+period exec swaymsg "output * transform 270"
bindsym $mod+Shift+comma exec swaymsg "output * transform 0"

#==============================================================================
#++++++++++++++++++++++++++++++++ MUSIC +++++++++++++++++++++++++++++++++++++++
#==============================================================================
bindsym $mod+F1 exec kitty --class floating sh -c rmpc

bindsym $mod+F2 exec --no-startup-id volume down
bindsym $mod+F3 exec --no-startup-id volume up
bindsym $mod+F4 exec --no-startup-id volume mute

bindsym $mod+F5 exec playerctl play-pause
bindsym $mod+F6 exec mpc prev
bindsym $mod+F7 exec mpc toggle
bindsym $mod+F8 exec mpc next

bindsym $mod+Home exec mpc play 1
bindsym $mod+End exec sh -c 'mpc play "$(mpc playlist | wc -l)"'


bindsym control+alt+backspace exit


#==============================================================================
#+++++++++++++++++++++++++++++ DMENU SCRIPTS ++++++++++++++++++++++++++++++++++
#==============================================================================

set $men dmenu -l 8 -g 4 -nb "#0F0F0F" -p "Run: " -i
set $menu killall dmenu || dmenu_run -l 8 -g 4 -nb "#0F0F0F" -p "Run: " -i
set $appmenu j4-dmenu-desktop --dmenu='dmenu -l 8 -g 4 -nb "#0F0F0F" -p "Run: "'

bindsym $mod+d exec $menu
bindsym $mod+shift+d exec $appmenu
bindsym $mod+shift+p exec keepmenu
bindsym $mod+p exec wizdmenu

bindsym Print exec screenshot select
bindsym Shift+Print exec screenshot screen

#==============================================================================
#+++++++++++++++++++++++ Resizing keyshortcuts ++++++++++++++++++++++++++++++++
#==============================================================================

bindsym $mod+r mode "resize"

mode "resize" {

    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

#==============================================================================
#+++++++++++++++++++++++++++ Window setting +++++++++++++++++++++++++++++++++++
#==============================================================================

for_window [app_id="mpv"] floating enable, resize set 900 500, move position center
for_window [app_id="dragon-drop"] sticky enable, resize set 500 500
for_window [app_id="floating"] floating enable, sticky enable, resize set 1400 800, move position center
for_window [app_id="nb"] floating enable, sticky enable, resize set 1400 800, move position center,move scratchpad,scratchpad show

# Move Steam and games to workspace 10
workspace 10 layout tabbed
# Route the main Steam app to workspace 10
assign [class="^steam$"] 10
# Route Steam games to workspace 10 (Matches classes starting with steam_app_ or specific game classes)
assign [class="^steam_app_"] 10
assign [class="^cs2$"] 10


# Define the layout rule for workspace 1 upfront
workspace 1 layout tabbed

# Move the applications to workspace 1
for_window [app_id="librewolf"] move container to workspace number 1
for_window [class="LibreWolf"]  move container to workspace number 1
for_window [app_id="zen-browser"] move container to workspace number 1
for_window [class="zen-beta"]    move container to workspace number 1

#==============================================================================
#+++++++++++++++++++++++++++++ Stylings +++++++++++++++++++++++++++++++++++++++
#==============================================================================

smart_borders on
default_border pixel 1

hide_edge_borders smart

gaps inner 0
gaps outer 0


input type:keyboard {
    xkb_layout us
    xkb_options caps:swapescape
}

#==============================================================================
#++++++++++++++++++++++++ RUN FILES ON STARTUP ++++++++++++++++++++++++++++++++
#==============================================================================
exec --no-startup-id ~/.config/i3/scripts/startup.sh

#==============================================================================
#+++++++++++++++++++++++++++++++++++ END ++++++++++++++++++++++++++++++++++++++
#==============================================================================
